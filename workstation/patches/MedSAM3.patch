-        super().__init__()
-
-        # Encoder
-        # Use our separated layer to enable full LoRA testing
-        encoder_layer = SeparatedTransformerEncoderLayer(
-            d_model=d_model,
-            nhead=nhead,
-            dim_feedforward=dim_feedforward,
-            batch_first=True,
-        )
-        self.encoder = nn.TransformerEncoder(encoder_layer, num_encoder_layers)
-
-        # Decoder
