-        self.decoder = nn.TransformerDecoder(decoder_layer, num_decoder_layers)
-
-        # Output head
-        self.head = nn.Linear(d_model, 10)
-
-    def forward(self, src, tgt):
-        memory = self.encoder(src)
-        output = self.decoder(tgt, memory)
-        return self.head(output)
