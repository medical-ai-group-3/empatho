-    COCO format:
-    {
-        "images": [{"id": 1, "file_name": "img.jpg", ...}],
-        "annotations": [{"image_id": 1, "category_id": 1, "bbox": [x,y,w,h], ...}],
-        "categories": [{"id": 1, "name": "cat"}, ...]
-    }
