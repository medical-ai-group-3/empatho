# EMPATHO — 환경 설정 견본
#
# 이 파일을 .env.local 로 복사해서 쓴다. .env.local 은 git 에 안 올라간다
# (.gitignore 의 *.local).
#
#   copy env.example .env.local
#
# 값을 안 주면 아래 「기본」대로 돈다. 평소에는 건드릴 일이 없다.


# ── 병원 웹이 부를 API 주소 앞머리 ───────────────────────────────
# 기본
#   npm run dev:mock  →  /api/v1/hospital   (mock/hospital.js 가 받는다)
#   npm run dev       →  /api/v1            (nginx 가 Django 로 넘긴다)
#
# Django 쪽 주소가 정해지면 여기서 덮어쓴다. 코드는 안 고친다.
# VITE_API_BASE=/api/v1/staff


# ── 붙을 서버 ────────────────────────────────────────────────────
# vite.config.js 가 /api 와 /svc 를 이 주소로 넘긴다.
# 기본값은 vite.config.js 위쪽 SERVER 에 있다.
# EMPATHO_SERVER=https://empatho.example.com


# ── 본인인증(포트원 V2 · KG이니시스 통합인증) ─────────────────────
# 가입 화면(src/screens/Signup.jsx)이 쓴다. 둘 다 공개 값이라 앱에 들어가도 된다.
# API Secret 은 여기 넣지 않는다 — 서버(empatho-app conf/web.env)에만 둔다.
#   포트원 콘솔 → 결제 연동 → 연동 정보 → 채널 관리(채널 속성: 본인인증)
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
