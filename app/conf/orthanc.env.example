ORTHANC__NAME=empatho
ORTHANC__INDEX_DIRECTORY=/var/lib/orthanc/index
ORTHANC__STORAGE_DIRECTORY=/var/lib/orthanc/storage
ORTHANC__AUTHENTICATION_ENABLED=true
ORTHANC__REGISTERED_USERS={"empatho":"__ORTHANC_PASSWORD__"}
ORTHANC__REMOTE_ACCESS_ALLOWED=true
ORTHANC__DICOM_WEB__ENABLE=true
ORTHANC__DICOM_SERVER_ENABLED=false