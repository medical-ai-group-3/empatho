# 복사해서 채운다. conf/web.env 는 커밋하지 않는다(.gitignore 의 *.env).
#
#   cp conf/web.env.example conf/web.env
#
# 따옴표를 쓰지 않는다 — env_file 은 따옴표를 값의 일부로 읽는다.
#
# 각자 PC 에서 도커 없이 개발할 때는 이 파일을 services/django/.env 로 복사한다.
# settings.py 가 거기서 읽는다. 그때는 DB_HOST 를 localhost 로 바꾼다.

# 비어 있으면 settings.py 의 개발용 기본값이 쓰인다. 서버에서는 반드시 채운다.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# True 로 두지 않는다 — 오류 화면에 설정값과 SQL 이 그대로 노출된다.
DJANGO_DEBUG=False

# DEBUG=False 면 반드시 채운다. 비어 있으면 모든 요청이 400 으로 떨어진다.
# web 은 컨테이너 이름 — 같은 네트워크의 gateway 가 이 이름으로 부른다.
#
# ⚠ **접속에 쓰는 도메인이 여기 없으면 그 주소로 온 요청이 전부 400
#   DisallowedHost 다.** 화면에는 「Bad Request」만 뜨고 이유가 안 보인다.
DJANGO_ALLOWED_HOSTS=empatho.example.com,localhost,127.0.0.1,web

# README 의 공유 postgres. DB 이름과 사용자 모두 empatho 다.
# 비밀번호는 서버 담당에게 받는다 — conf/postgres.env 와 같은 값이어야 한다.
DB_NAME=empatho
DB_USER=empatho
DB_PASSWORD=
# 컨테이너 안에서는 서비스 이름으로 찾는다. 로컬 개발은 localhost.
DB_HOST=postgres
DB_PORT=5432

# 프론트 오리진을 쉼표로 구분해 넣는다.
#
# 평소에는 안 탄다 — 프런트(empatho-view)가 vite 프록시로 /api 와 /svc 를
# 넘겨서 브라우저에는 같은 출처로 보인다. 프록시를 안 거치고 Django 를
# 직접 부를 때만 이 목록이 걸린다.
#
# CORS_ALLOW_CREDENTIALS=True 라 "*" 는 못 쓴다. 출처를 정확히 적어야 한다.
# conf/gosvc.env.example 의 CORS_ORIGINS 와 같은 값을 둔다.
# ⚠ **배포 도메인은 안 적는다.** nginx 한 대가 화면과 /api 를 같이 주므로
#   브라우저가 같은 출처로 본다 — 교차 출처가 아니라 CORS 가 안 걸린다.
#   아래는 개발용이다(각자 PC 의 vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ── HTTPS 로 올릴 때 (nginx 뒤) ────────────────────────────────────
#
# 서버에서만 켠다. 로컬 개발은 http 라 켜면 **로그인이 안 된다** —
# Secure 쿠키가 http 로는 안 내려간다.
#
# 켜면 셋이 같이 걸린다 (settings.py 의 BEHIND_TLS_PROXY)
#   · X-Forwarded-Proto 를 믿는다  → Secure 쿠키가 내려간다
#   · SESSION_COOKIE_SECURE=True   → admin 세션
#   · CSRF_COOKIE_SECURE=True
#
# ⚠ nginx 를 안 거치고 Django 가 직접 열려 있으면 켜지 말 것. 바깥에서 보낸
#   X-Forwarded-Proto 를 그대로 믿게 된다. nginx 는 그 헤더를 덮어쓴다.
# 배포(https://empatho.example.com)는 nginx 뒤라 켠다. 로컬은 그대로 둔다.
# DJANGO_BEHIND_TLS_PROXY=True

# 폼을 POST 하는 자리(Django admin)가 쓴다. **스킴까지 적는다.**
# 빠뜨리면 admin 로그인이 403 CSRF 로 막힌다. API 는 JWT 라 상관없다.
# CSRF_TRUSTED_ORIGINS=https://empatho.example.com

# DJANGO_ALLOWED_HOSTS 에는 도메인을 이미 넣어 두었다(위).
# CORS_ALLOWED_ORIGINS 에는 **도메인을 넣지 않는다** — 같은 출처라
# CORS 자체가 안 걸린다.
# JWT. 비어 있으면 DJANGO_SECRET_KEY 를 쓴다 — 서버에서는 따로 채운다.
# 따로 두는 이유: SECRET_KEY 를 돌리면 세션·CSRF 까지 끊긴다. 토큰만 무효화하고
# 싶을 때가 있다. 값을 바꾸면 발급된 토큰이 전부 무효가 된다.
JWT_SECRET=
JWT_ISSUER=empatho-cdss
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Go → Django 내부 콜백(명세 21장)의 서명 키.
# conf/gosvc.env 의 CALLBACK_SECRET 과 **같은 값**이어야 한다. 어긋나면
# 콜백이 오류가 아니라 401 로 조용히 거절된다.
# 비어 있으면 Django 가 콜백을 아예 받지 않는다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CALLBACK_SECRET=
# 서명의 X-Timestamp 허용 시간차(초). Go 가 nonce 를 안 보내서 이 창이
# 재전송을 막는 유일한 수단이다.
CALLBACK_TIMESTAMP_TOLERANCE_SEC=300

# 전송 티켓(명세 19-1) 서명 키. Django 가 서명하고 Go 가 검증한다.
# conf/gosvc.env 의 TICKET_KEY 와 **같은 값**이어야 한다.
#
# CALLBACK_SECRET 과는 **절대 같은 값을 쓰지 않는다.** 방향이 반대다 —
# 티켓은 클라이언트가 들고 다니므로, 같은 값이면 그 서명 재료로 Django 로
# 오는 콜백을 위조할 수 있다. 기동 때 시스템 검사가 막는다.
#   python -c "import secrets; print(secrets.token_hex(32))"
TICKET_KEY=
# purpose 별 유효기간(초)을 덮어쓸 때만 쓴다. 비우면 settings 의 기본값이다.
#   tile 900 · download 120 · 업로드 계열 300
#TICKET_TTL_TILE=900
#TICKET_TTL_DOWNLOAD=120

# ── 판독 대기열 ────────────────────────────────────────────────────────
# redis 는 compose 의 컨테이너 이름이다. 도커망 안에서 이름으로 찾는다.
# 0 번은 큐, 1 번은 태스크 결과 — 같은 Redis 안에서 번호로만 나눈다.
#
# settings.py 에 같은 기본값이 있어 비워 둬도 돈다. 여기 적어 두면
# 브로커를 옮길 때 코드를 안 고친다.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── 약 정보(식약처 e약은요 · data.go.kr) ───────────────────────────────
# 환자 앱의 「약 정보 찾기」가 쓴다. 비면 그 기능만 503 이고 나머지는 돈다.
#
# ⚠ 일반 인증키(Decoding)를 **그대로** 넣는다. 포털이 보여 주는 Encoding
#   키를 넣으면 한 번 더 인코딩돼 서명이 깨진다.
# ⚠ 이 값은 계정에 묶여 있다. 저장소(.env.example 포함)에 실제 키를 적지 않는다.
DRUG_API_KEY=
# 아래 셋은 기본값이 settings.py 에 있다. 덮어쓸 때만 푼다.
#DRUG_API_BASE=https://apis.data.go.kr/1471000/DrbEasyDrugInfoService
#DRUG_API_TIMEOUT_SEC=8
#DRUG_API_CACHE_SEC=86400

# ── 병원 찾기(심평원 병원정보서비스 · data.go.kr) ──────────────────────
# 환자 앱의 「병원 찾기」가 쓴다. 비면 그 기능만 503 이고 나머지는 돈다.
#
# ⚠ 위 DRUG_API_KEY 와 **같은 일반 인증키를 쓰지만 서비스 등록은 따로다.**
#   포털에서 「건강보험심사평가원_병원정보서비스」 활용신청을 먼저 해야
#   한다 — 안 하면 403 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 다.
HOSPITAL_API_KEY=
#HOSPITAL_API_BASE=https://apis.data.go.kr/B551182/hospInfoServicev2
#HOSPITAL_API_TIMEOUT_SEC=8
#HOSPITAL_API_CACHE_SEC=43200
