# Go 서비스 셋이 함께 읽는다 — file-gateway · llm-proxy · notify.
# 복사해서 채운다. conf/gosvc.env 는 커밋하지 않는다(.gitignore 의 *.env).
#
#   cp conf/gosvc.env.example conf/gosvc.env
#
# 따옴표를 쓰지 않는다 — env_file 은 따옴표를 값의 일부로 읽는다.


# ── Django 와 맞춰야 하는 값 ────────────────────────────────────────────
# 둘 다 Django 쪽과 같은 값이어야 한다. 어긋나면 티켓 검증과 콜백 서명이
# 전부 실패하는데, 오류가 아니라 401 로 조용히 거절된다.
TICKET_KEY=
CALLBACK_SECRET=

# 우리 Django 서비스 이름은 web 이다. gosvc 기본값은 django 였다.
# 같은 스택 안이라 이름으로 부른다 — 127.0.0.1 은 자기 자신이다.
CALLBACK_BASE=http://web:8000

# mTLS. 비우면 콜백이 평문으로 나가고 기동 때 경고가 뜬다.
# 사내망 안이고 인증서가 아직 없어 지금은 비워 둔다.
CALLBACK_CERT=
CALLBACK_KEY=


# ── Garage · 파일 저장소 ────────────────────────────────────────────────
GARAGE_ENDPOINT=garage:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# 원본을 두는 버킷. 타일·썸네일·마스크는 empatho-derived 로 가야 하는데
# 지금 gosvc 는 버킷 변수가 하나뿐이다 — Go 담당과 확인할 것.
GARAGE_BUCKET=empatho-original


# ---- Orthanc · DICOM ---------------------------------------------------
# MRI 전용이 아니다 — 맘모 DICOM 도 여기 등록된다.
# 비우면 DICOM 만 해석해서 I-2 콜백을 보내고 전송은 건너뛴다.
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=
ORTHANC_PASS=


# ── Ollama · 워크스테이션 ───────────────────────────────────────────────
# 아직 안 닿는다. Ollama 는 워크스테이션에 있고 터널이 11434 를 열어 두지
# 않았다. 열기 전까지 llm-proxy 호출은 실패한다 — 다른 서비스는 영향 없다.
# 컨테이너에서 이 PC 밖으로 나갈 때는 127.0.0.1 이 아니라 이 이름을 쓴다.
OLLAMA_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=medgemma1.5:4b-it-q4_K_M


# ── 알림 ────────────────────────────────────────────────────────────────
# 구독자당 버퍼. 넘치면 resync 를 보낸다.
NOTIFY_BUFFER=32
