# Go 서비스 셋이 함께 읽는다 — file-gateway · llm-proxy · notify.
# 복사해서 채운다. conf/gosvc.env 는 커밋하지 않는다(.gitignore 의 *.env).
#
#   cp conf/gosvc.env.example conf/gosvc.env
#
# 따옴표를 쓰지 않는다 — env_file 은 따옴표를 값의 일부로 읽는다.


# ── Django 와 맞춰야 하는 값 ────────────────────────────────────────────
# 둘 다 Django 쪽과 같은 값이어야 한다. 어긋나면 티켓 검증과 콜백 서명이
# 전부 실패하는데, 오류가 아니라 401 로 조용히 거절된다.
TICKET_KEY=
CALLBACK_SECRET=

# 우리 Django 서비스 이름은 web 이다. gosvc 기본값은 django 였다.
# 같은 스택 안이라 이름으로 부른다 — 127.0.0.1 은 자기 자신이다.
CALLBACK_BASE=http://web:8000

# mTLS. 비우면 콜백이 평문으로 나가고 기동 때 경고가 뜬다.
# 사내망 안이고 인증서가 아직 없어 지금은 비워 둔다.
CALLBACK_CERT=
CALLBACK_KEY=


# ── Garage · 파일 저장소 ────────────────────────────────────────────────
GARAGE_ENDPOINT=garage:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# 원본을 두는 버킷. 타일·썸네일·마스크는 empatho-derived 로 가야 하는데
# 지금 gosvc 는 버킷 변수가 하나뿐이다 — Go 담당과 확인할 것.
GARAGE_BUCKET=empatho-original

# 파생물 버킷 — 우리가 만들어 낸 것(3D 메시 · 마스크 · 타일)이 들어간다.
# 원본과 나누는 이유는 수명이 달라서다. 파생물은 모델이 바뀌면 다시 만들면
# 되고, 원본은 그럴 수 없다.
#
# 비워 두면 /svc/v1/derived 경로가 404 를 낸다. 조용히 원본 버킷에 쓰지 않는다 —
# 설정 누락과 정상 동작이 같아 보이면 아무도 모른 채 원본이 더러워진다.
GARAGE_BUCKET_DERIVED=empatho-derived


# ── Orthanc · MRI DICOM ─────────────────────────────────────────────────
# 비우면 DICOM 만 해석해서 I-2 콜백을 보내고 전송은 건너뛴다.
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=
ORTHANC_PASS=


# ── 리포트 서버 (소견 생성) ─────────────────────────────────────────────
# Ollama 를 직접 부르지 않는다. 소견 생성·숫자 검사·근거 검사가 전부
# 워크스테이션 리포트 서버 안에서 끝난다.
#
# tunnel 은 compose 의 터널 컨테이너다. 워크스테이션 8002 로 SSH 포트
# 넘김을 걸어 두고 restart: unless-stopped 로 스스로 살아난다.
REPORT_BASE=http://tunnel:8002

# 소견 하나는 1초 미만이지만 모델이 내려가 있으면 적재에 3초가 더 붙고,
# 앞에 요청이 줄 서 있으면 그만큼 더 걸린다. 짧게 잡으면 멀쩡한 요청이 끊긴다.
REPORT_TIMEOUT=2m


# ── 알림 ────────────────────────────────────────────────────────────────
# 구독자당 버퍼. 넘치면 resync 를 보낸다.
NOTIFY_BUFFER=32

# ── 브라우저 업로드 (CORS) ────────────────────────────────
# 허용할 프런트 출처. 쉼표로 여러 개.
# ⚠ 비워두면 브라우저 업로드가 preflight(OPTIONS)에서 막힌다.
#   Authorization 헤더가 붙는 요청이라 "*" 는 브라우저가 거부한다 →
#   실제 출처를 정확히 적어야 한다.
CORS_ORIGINS=http://localhost:5173,http://app-host:5173

# Garage 서명 계산에 쓰는 리전 값.
# conf/garage.toml 의 s3_api.s3_region 과 같아야 한다.
# 다르면 SignatureDoesNotMatch 로 업로드가 통째로 실패한다.
GARAGE_REGION=garage

# ── 개발 전용. 운영에서는 절대 켜지 말 것 ──────────────────
# Garage 대신 로컬 디스크에 저장한다. 시험용이다.
# GW_LOCAL_ROOT 만 있고 GW_DEV=1 이 없으면 게이트웨이는 시작을 거부한다 —
# 운영에서 파일이 컨테이너 안에 쌓이는 사고를 구조적으로 막는 장치다.
# GW_LOCAL_ROOT=/tmp/gw-store
# GW_DEV=1
