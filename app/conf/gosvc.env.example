# services/gosvc 가 읽는 환경변수. 이 파일은 **이름만** 적고 값은 안 적는다.
# 실제 값은 서버의 ~/empatho-conf/gosvc.env 에 있고 배포 러너가 conf/ 로 복사한다.
#
# ⚠ 코드에 새 환경변수를 넣으면 **반드시 여기에 이름을 추가하고 함께 커밋한다.**
#    안 하면 코드만 배포되고 값이 비어서, 기동에 실패하거나 조용히 기본값으로 돈다.

# ── Django 와 공유 ─────────────────────────────────────────────────
TICKET_KEY=
CALLBACK_SECRET=
CALLBACK_BASE=http://web:8000
CALLBACK_CERT=
CALLBACK_KEY=

# ── Garage ────────────────────────────────────────────────────────
GARAGE_ENDPOINT=garage:3900
GARAGE_REGION=garage
GARAGE_BUCKET=empatho-original
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# ── Orthanc ───────────────────────────────────────────────────────
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=
ORTHANC_PASS=

# ── Ollama ────────────────────────────────────────────────────────
# 워크스테이션에 있다. 터널에 11434 가 열려야 llm-proxy 요청이 통한다.
OLLAMA_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=medgemma

# ── 새로 추가된 것 (2026-09-02) ────────────────────────────────────
#
# CORS_ORIGINS — **이게 비어 있으면 브라우저 업로드가 사전 요청에서 막힌다.**
#   Go 를 따로 둔 목적이 바이트가 Django 를 안 거치는 것이라, 브라우저가
#   Go 를 직접 부른다. 프런트 출처와 Go 는 서로 다른 출처다.
#   쉼표로 여러 개. nginx 로 같은 출처에 묶었다면 비워 둔다.
CORS_ORIGINS=

# 알림 구독자당 버퍼. 넘치면 화면에 resync 를 보낸다.
NOTIFY_BUFFER=32

# ⚠ 아래 둘은 **운영에 절대 넣지 말 것.**
#   GW_LOCAL_ROOT 를 넣으면 Garage 를 무시하고 컨테이너 안 디스크에 쓴다.
#   재시작하면 파일이 사라지는데 업로드는 201 로 성공하고 로그도 정상이다.
#   그래서 GW_DEV=1 이 함께 없으면 기동을 거부하도록 막아 뒀다.
# GW_LOCAL_ROOT=
# GW_DEV=
