# gosvc 환경변수 본보기. 값을 채워 .env 로 복사한다.
# ⚠ .env 는 커밋하지 않는다. 비밀번호는 담당자에게 따로 받는다.

# ── Django 와 공유하는 값 ───────────────────────────────────────────
# 둘 다 Django 쪽과 **똑같아야** 한다. 다르면 티켓·콜백이 전부 막힌다.
TICKET_KEY=
CALLBACK_SECRET=
CALLBACK_BASE=http://django:8000

# mTLS — 운영 필수. 비면 콜백이 평문으로 나가고 기동 시 경고가 뜬다
CALLBACK_CERT=
CALLBACK_KEY=

# ── Garage (파일 저장소 · S3 호환) ──────────────────────────────────
#
# ⚠ Go 가 Docker 안에서 돌고 터널을 **호스트**에서 열었다면,
#   컨테이너의 127.0.0.1 은 컨테이너 자신이라 안 닿는다.
#   host.docker.internal 을 쓸 것 (compose 에 extra_hosts 를 넣어 뒀다).
#
#   호스트에서 직접 실행   127.0.0.1:13900
#   Docker + 호스트 터널   host.docker.internal:13900
#   같은 compose 망 안     garage:3900
GARAGE_ENDPOINT=host.docker.internal:13900
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# 원본 파일이 들어가는 버킷.
# 타일·썸네일·마스크처럼 만들어낸 것은 empatho-derived 로 간다
# (아직 G-F6·피라미드를 안 만들어서 여기서는 안 쓴다).
GARAGE_BUCKET=empatho-original

# ── Orthanc (DICOM 서버) ────────────────────────────────────────────
#
# 맘모 DICOM 도 여기에 등록한다. 파일 원본은 Garage 에, 촬영 정보는
# Orthanc 에 들어가고 둘을 I-2 의 orthanc_instance_id 로 잇는다.
#
# ⚠ 접속 안내서에는 "MRI 만 들어간다" 고 적혀 있는데 **그 문서가 틀렸다.**
#   맘모도 넣는다. 안내서를 고쳐 달라고 담당자에게 알릴 것 —
#   그대로 두면 다른 팀원이 이 값을 비우고 띄운다.
#
# 비우면 DICOM 을 파싱해 I-2 만 보내고 Orthanc 전송은 건너뛴다(개발용).
#   호스트에서 직접 실행   http://127.0.0.1:18042
#   Docker + 호스트 터널   http://host.docker.internal:18042
#   같은 compose 망 안     http://orthanc:8042
ORTHANC_URL=http://host.docker.internal:18042
ORTHANC_USER=empatho
ORTHANC_PASS=

# ── Ollama ─────────────────────────────────────────────────────────
OLLAMA_BASE=http://ollama:11434
OLLAMA_MODEL=medgemma

# ── 프런트 ─────────────────────────────────────────────────────────
# 브라우저가 Go 를 직접 부른다(바이트가 Django 를 안 거치는 것이 설계 목적).
# 프런트 출처를 여기 적지 않으면 업로드·SSE 가 사전 요청에서 막힌다.
# nginx 로 같은 출처에 묶었다면 비워 둘 것.
CORS_ORIGINS=http://localhost:5173

# 알림 구독자당 버퍼. 넘치면 resync 를 보낸다
NOTIFY_BUFFER=32

# ── 개발 전용 ───────────────────────────────────────────────────────
# ⚠ 설정하면 Garage 대신 컨테이너 안 디스크에 쓴다. 재시작하면 사라진다.
#    GW_DEV=1 이 함께 없으면 기동을 거부한다.
#    **운영 .env 에는 두 줄 다 없어야 한다.**
GW_LOCAL_ROOT=
GW_DEV=
