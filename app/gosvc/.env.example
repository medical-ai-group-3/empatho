# gosvc 환경변수 본보기. 실제 값을 넣어 .env 로 복사한다.
# ⚠ .env 는 커밋하지 않는다.

# Django 와 **같은 값**이어야 한다
TICKET_KEY=
CALLBACK_SECRET=
CALLBACK_BASE=http://django:8000

# mTLS — 운영 필수. 비면 콜백이 평문으로 나가고 기동 시 경고가 뜬다
CALLBACK_CERT=
CALLBACK_KEY=

# Garage (S3 호환)
GARAGE_ENDPOINT=garage:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=cdss

# Orthanc — 비우면 DICOM 파싱해서 I-2 만 보내고 전송은 건너뛴다
ORTHANC_URL=
ORTHANC_USER=
ORTHANC_PASS=

# Ollama
OLLAMA_BASE=http://ollama:11434
OLLAMA_MODEL=medgemma

# 알림 구독자당 버퍼. 넘치면 resync 를 보낸다
NOTIFY_BUFFER=32

# 브라우저가 Go 를 직접 부를 때의 프런트 출처. 쉼표로 여러 개.
# 비우면 교차 출처 요청을 안 받는다(리버스 프록시 구성일 때).
# 예: http://localhost:5173,https://cdss.example.org
CORS_ORIGINS=

# ⚠ 개발 전용. 설정하면 Garage 대신 컨테이너 안 디스크에 쓴다.
#    재시작하면 사라진다. GW_DEV=1 이 함께 없으면 기동을 거부한다.
#    운영 .env 에는 두 줄 다 없어야 한다.
GW_LOCAL_ROOT=
GW_DEV=
