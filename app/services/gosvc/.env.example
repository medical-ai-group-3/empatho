# gosvc 환경변수 본보기. 실제 값을 넣어 .env 로 복사한다.
# ⚠ .env 는 커밋하지 않는다.

# Django 와 **같은 값**이어야 한다
TICKET_KEY=
CALLBACK_SECRET=
CALLBACK_BASE=http://web:8000

# mTLS — 운영 필수. 비면 콜백이 평문으로 나가고 기동 시 경고가 뜬다
CALLBACK_CERT=
CALLBACK_KEY=

# Garage (S3 호환)
GARAGE_ENDPOINT=garage:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=empatho-original

# Orthanc — 비우면 DICOM 파싱해서 I-2 만 보내고 전송은 건너뛴다
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=
ORTHANC_PASS=

# Ollama
OLLAMA_BASE=
OLLAMA_MODEL=medgemma

# 알림 구독자당 버퍼. 넘치면 resync 를 보낸다
NOTIFY_BUFFER=32
