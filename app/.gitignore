# 비밀번호가 들어간다
conf/garage/garage.toml
conf/orthanc.env

__pycache__/
*.pyc
*.env

# Django 
venv/
.venv/
db.sqlite3
staticfiles/
media/
*.log

# 스키마 덤프의 압축본만 제외한다.
services/django/db/*.sql.gz

# 인계받은 원본 문서. 바이너리는 저장소에 두지 않는다 — 읽고 정리한 결과만 남긴다.
*.docx
*.pptx
*.xlsx

# 빌드 산출물
services/gosvc/file-gateway
services/gosvc/llm-proxy
services/gosvc/bin/

# vendor 는 커밋하지 않는다 — minio-go 때문에 17MB 다.
# 처음 받는 사람은 `go mod download` 한 번이면 된다.
services/gosvc/vendor/
web-dist/*
!web-dist/.gitkeep

# 웹 — npm 산출물은 커밋하지 않는다.
#
# 한 번 들어온 적이 있다. services/web/.gitignore 가 web-scaffold 에만
# 있어서, 그 브랜치를 떠나는 순간 node_modules 가 무시 대상에서 풀리고
# 616개가 통째로 커밋됐다. 브랜치마다 규칙이 다른 것이 화근이었으므로
# 여기 루트에 둔다 — 어느 브랜치에 있든 걸린다.
#
# 받는 사람은 `npm install` 한 번이면 된다.
services/web/node_modules/
services/web/dist/
services/web/.vite/

# tunnel 컨테이너가 워크스테이션에 붙을 때 쓰는 SSH 개인키
# 워크스테이션 SSH 자격. 폴더째 제외한다 — 파일이 늘어도 새는 일이 없다.
conf/ws/

# 테스트가 만드는 고정값
services/django/test_*.json
